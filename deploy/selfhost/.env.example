# Copy to .env in this directory. docker compose reads it automatically.
# This file is the ONLY place credentials live — nothing is baked into an image.

# ── required ────────────────────────────────────────────────────────────────
# Postgres superuser password. Also used by cron/newswatch/bot (they write).
POSTGRES_PASSWORD=

# Read-only role used by the MCP server. Created during bootstrap by
# `apply_schema.py --rls`, which reads this same value from the repo-root .env.
MCP_VIEWER_PASSWORD=

# URL-as-secret for the MCP mount path. Anything unguessable; 40 chars is fine.
# Changing it changes every consumer URL (claude.ai connector, web/.env).
MCP_BEARER_TOKEN=

# Must already resolve to this host's public IP before the first `up`, or
# Caddy will retry the ACME challenge into a Let's Encrypt rate limit.
MCP_DOMAIN=mcp.example.com

# ── Telegram ────────────────────────────────────────────────────────────────
# Used by the bot webhook (mcp) and the news poller (newswatch).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret Telegram sends back as X-Telegram-Bot-Api-Secret-Token. Set it
# with setWebhook; the webhook 403s every request without it.
TELEGRAM_WEBHOOK_SECRET=

# Separate on purpose. Leave BLANK while the GitHub Actions workflows still run
# the same schedules: everything about a double run is idempotent except the
# message layer, so filling these makes every brief and alert arrive twice.
# Fill them when you disable the workflows — until then a cron failure here is
# silent, and GitHub Actions is what alerts you.
CRON_TELEGRAM_TOKEN=
CRON_TELEGRAM_CHAT_ID=

# ── data sources ────────────────────────────────────────────────────────────
# Free tier is 600 req/hr. Empty ⇒ the nightly FinMind enrichment self-skips.
FINMIND_TOKEN=
FUGLE_API_KEY=

# ── tuning ──────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30
NEWS_POLL_SECONDS=180

# ── backup.sh (exported by cron, not read by compose) ───────────────────────
# BACKUP_DIR=/var/backups/alphatecx
# RETAIN_DAYS=14
# Without this the backup lives only on the same disk as the database, which
# survives bad SQL but not a dead host.
# RCLONE_REMOTE=b2:alphatecx-backups
