# Postgres. Neon today; a Zeabur cutover is pending, and Zeabur has TLS
# disabled — drop sslmode=require when you switch or the connection is refused.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional read-only DSN for the MCP server and Telegram bot. Falls back to
# DATABASE_URL when empty.
MCP_DATABASE_URL=

# URL-as-secret for the MCP server. REQUIRED — mcp_server/api/index.py refuses
# to start without it, since an empty token makes the mount path /mcp/ and the
# auth gate would silently 404 every request. Same token gates /g /d /h /t.
MCP_BEARER_TOKEN=

# Password for the read-only mcp_viewer role. Only needed by
# `python apply_schema.py --rls`, which exits without it.
MCP_VIEWER_PASSWORD=

# Telegram
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# TWSE rate limiting
TWSE_REQUEST_DELAY=3.0
TWSE_BACKFILL_DAYS=90

# HTTP
HTTP_TIMEOUT=20

# Fugle Market Data API — realtime quotes (optional; quote falls back to TWSE MIS without it)
FUGLE_API_KEY=

# FinMind open financial data API — https://finmind.github.io (free registered tier = 600 req/hr)
FINMIND_TOKEN=
