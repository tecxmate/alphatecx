# Postgres. Neon today; a Zeabur cutover is pending, and Zeabur has TLS
# disabled — drop sslmode=require when you switch or the connection is refused.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional read-only DSN for the MCP server and Telegram bot. Falls back to
# DATABASE_URL when empty.
MCP_DATABASE_URL=

# URL-as-secret for the MCP server. REQUIRED — mcp_server/api/index.py refuses
# to start without it, since an empty token makes the mount path /mcp/ and the
# auth gate would silently 404 every request. Gates /mcp only.
MCP_BEARER_TOKEN=

# URL-as-secret for the human console (/d /g /h /t). OPTIONAL: left empty it
# falls back to MCP_BEARER_TOKEN, which is exactly how this behaved before
# 2026-08-16 — and why you want to set it. While the two were one string, the
# dashboard link WAS the API credential: anyone shown the console could also
# call all 49 tools, several of which write. Set this to a different random
# value so sharing a dashboard URL shares only the dashboard.
# See docs/wiki/topics/console-auth.md.
CONSOLE_TOKEN=

# Password for the read-only mcp_viewer role. Only needed by
# `python apply_schema.py --rls`, which exits without it.
MCP_VIEWER_PASSWORD=

# Category switches under TELEGRAM_ENABLED, all default on. Turn one off to
# silence that kind of message without going fully dark:
#   TELEGRAM_BRIEFS  pre-market/intraday/post-close briefs, daily summary,
#                    thesis heartbeat
#   TELEGRAM_ALERTS  Risk Guard stops/light/settlement + the intraday watcher
#   TELEGRAM_NEWS    news poller watchlist pushes
#   TELEGRAM_OPS     harvest error alerts
#TELEGRAM_BRIEFS=
#TELEGRAM_ALERTS=
#TELEGRAM_NEWS=
#TELEGRAM_OPS=

# Intraday stop watcher (runs inside the news poller). Needs a Fugle Market
# Data key — https://developer.fugle.tw — set on the Zeabur worker service.
# Absent key = watcher idles with one log line. QUOTE_WATCH_ENABLED=false
# switches it off explicitly.
#FUGLE_API_KEY=
#QUOTE_WATCH_ENABLED=

# Telegram
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# News poller (src.news.watch). Seconds between cycles. Below ~60 the
# conditional GETs look like a scrape without buying anything — RSS files
# regenerate on the order of minutes. Only the poller service reads this.
NEWS_POLL_SECONDS=180

# TWSE rate limiting
TWSE_REQUEST_DELAY=3.0
TWSE_BACKFILL_DAYS=90

# HTTP
HTTP_TIMEOUT=20

# Fugle Market Data API — realtime quotes (optional; quote falls back to TWSE MIS without it)
FUGLE_API_KEY=

# FinMind open financial data API — https://finmind.github.io (free registered tier = 600 req/hr)
FINMIND_TOKEN=
