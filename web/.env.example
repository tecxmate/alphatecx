# --- Model provider selection ---
# LLM_PROVIDER: "anthropic" (default), "deepseek", or "google"
# LLM_MODEL: provider-specific model id; if unset, sensible default applies.
#
# Anthropic defaults:  claude-sonnet-4-5  (workspace convention: claude-sonnet-4-6)
# DeepSeek defaults:   deepseek-reasoner  (R1, "thinking" model — NO tool calls)
#                      deepseek-chat       (V3.2 — supports MCP tool calls)
# Google defaults:     gemini-2.5-flash   (free tier, tool calls + thinking built-in)
#                      gemini-2.5-pro     (smarter, lower free-tier rate limit)
#                      gemini-2.5-flash-lite  (fastest, cheapest)
# Note: Gemini 2.5 thinking is configurable per-request, not a separate model.
#
# WARNING: deepseek-reasoner does not support tool/function calling. When
# selected, the chat route strips MCP tools, so the assistant cannot query
# the TWSE database. Use deepseek-chat (or Anthropic) for tool-using turns.
LLM_PROVIDER=anthropic
LLM_MODEL=

# --- API keys (set the one(s) you use) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Full URL to the Python FastMCP server's streamable_http endpoint.
# Must end in a trailing slash. Path is just /mcp/<token>/ — no extra /mcp suffix.
# Local:  http://localhost:8000/mcp/<MCP_BEARER_TOKEN>/
# Prod:   https://<your-vercel-mcp>.vercel.app/mcp/<MCP_BEARER_TOKEN>/
MCP_SERVER_URL=

# Anonymous chat history persistence via assistant-ui Cloud.
# Sign up at https://cloud.assistant-ui.com and create a project; the
# project page shows a base URL that looks like
# https://<your-project-slug>.assistant.cloud
# When unset, threads + messages only live in browser memory.
NEXT_PUBLIC_ASSISTANT_BASE_URL=


